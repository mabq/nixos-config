#
# For more information read:
#  https://github.com/Vladimir-csp/uwsm?tab=readme-ov-file#4-environments-and-shell-profile
#  https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables

# ------------------------------------------------------------------------------

# PATH

# Include local and repo binaries in the path
export PATH="$HOME/.local/bin:$NC_REPO_PATH/bin:$PATH"

# ------------------------------------------------------------------------------

# XDG
#  https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/#xdg-specifications

#  NOTE: UWSM users don’t need to explicitly set these XDG environment
#  variables (uwsm sets them automatically).
export XDG_CURRENT_DESKTOP="Hyprland"
export XDG_SESSION_TYPE="wayland"
export XDG_SESSION_DESKTOP="Hyprland"

# ------------------------------------------------------------------------------

# DEFAULT APPS

export EDITOR="nvim"
export SUDO_EDITOR=$EDITOR
export VISUAL=$EDITOR
export MANPAGER="less -R --use-color -Dd+r -Du+b"
export MANROFFOPT="-P -c"  # https://wiki.archlinux.org/title/Color_output_in_console#Using_less
export PAGER="less -R --use-color -Dd+r -Du+b"
# export TERM=  # Do not set this variable, it is set by each terminal emulator.

#-------------------------------------------------------------------------------

# THEMING
#  https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/#theming-related-variables

# GTK
#  https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/#theming-related-variables
export GTK_THEME="Adwaita:dark"

# Cursor
#  Needs to be installed and readable by your user
#export XCURSOR_THEME=""
export XCURSOR_SIZE=24

# Bat
export BAT_THEME=ansi

# ------------------------------------------------------------------------------

# WAYLAND:
#  Instruct apps to use Wayland as the display backend.
#  https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/#toolkit-backend-variables

# GTK
export GDK_BACKEND="wayland,x11,*"

# QT
export QT_QPA_PLATFORM="wayland;xcb"

# SDL2
#  Remove or set to `x11` if games that provide older versions of SDL cause
#  compatibility issues.
export SDL_VIDEODRIVER="wayland"

# Clutter
export CLUTTER_BACKEND="wayland"

# Firefox based browsers
export MOZ_ENABLE_WAYLAND="1"

# Chromium and electron apps
export OZONE_PLATFORM="wayland"
export ELECTRON_OZONE_PLATFORM_HINT="wayland"

# ------------------------------------------------------------------------------

# QT VARIABLES
#  https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/#qt-variables

# Enable automatic scaling, based on the monitor’s pixel density
export QT_AUTO_SCREEN_SCALE_FACTOR="1"

# Disable window decorations on Qt applications
export QT_WAYLAND_DISABLE_WINDOWDECORATION="1"

# Tell Qt based applications to pick your theme from qt5ct (with Kvantum).
export QT_QPA_PLATFORMTHEME="qt5ct"
export QT_STYLE_OVERRIDE="kvantum"

