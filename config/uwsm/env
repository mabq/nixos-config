# ------------------------------------------------------------------------------
#
# All environment variables set in this file are sourced by uwsm and available
# to all managed compositors and graphical applications run inside such a
# session.
#
# For environment variables that only need to be set for a specific compositor
# (or graphical applications in that graphical session), put them in
# `${XDG_CONFIG_HOME}/uwsm/env-{COMPOSITOR}` instead.
#
# For more info, see:
#   Notes/environment-variables
#   Notes/uwsm
#   https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/
#   https://wiki.archlinux.org/title/Universal_Wayland_Session_Manager#Environment_variables
#   https://github.com/Vladimir-csp/uwsm?tab=readme-ov-file#4-environments-and-shell-profile
#
# ------------------------------------------------------------------------------

# -- THEMING VARIABLES

# GTK (read notes in `hypr-gtk` module)
# export GTK_THEME=""

# QT (read notes in `hypr-qt` module)
export QT_STYLE_OVERRIDE="kvantum"
export QT_QPA_PLATFORMTHEME="xdgdesktopportal"

# Cursor (read notes in `hypr-cursor` module)
export XCURSOR_THEME="Bibata-Modern-Ice"
export XCURSOR_SIZE=20

# ------------------------------------------------------------------------------

# -- XDG
#    https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/#xdg-specifications

# These are created by Hyprland and injected by uwsm into systemd
# export XDG_CURRENT_DESKTOP="Hyprland"
# export XDG_SESSION_TYPE="wayland"
# export XDG_SESSION_DESKTOP="Hyprland"

# Other XDG variables are set by the xdg Home-manager module, see:
#  /etc/profiles/per-user/mabq/etc/profile.d/hm-session-vars.sh:
#
#  export XDG_BIN_HOME="/home/mabq/.local/bin"
#  export XDG_CACHE_HOME="/home/mabq/.cache"
#  export XDG_CONFIG_HOME="/home/mabq/.config"
#  export XDG_DATA_HOME="/home/mabq/.local/share"
#  export XDG_DESKTOP_DIR="/home/mabq/Desktop"
#  export XDG_DOCUMENTS_DIR="/home/mabq/Documents"
#  export XDG_DOWNLOAD_DIR="/home/mabq/Downloads"
#  export XDG_MUSIC_DIR="/home/mabq/Music"
#  export XDG_PICTURES_DIR="/home/mabq/Pictures"
#  export XDG_PROJECTS_DIR="/home/mabq/Projects"
#  export XDG_PUBLICSHARE_DIR="/home/mabq/Public"
#  export XDG_SCREENSHOTS_DIR="/home/mabq/Pictures/Screenshots"
#  export XDG_STATE_HOME="/home/mabq/.local/state"
#  export XDG_TEMPLATES_DIR="/home/mabq/Templates"
#  export XDG_VIDEOS_DIR="/home/mabq/Videos"

# ------------------------------------------------------------------------------

# Instruct apps to use Wayland
#  https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/#toolkit-backend-variables
#  To check if an app is not running natively under Wayland use `xlsclients`.
export ELECTRON_OZONE_PLATFORM_HINT="auto" # Electron 28+ apps (VS Code, Slack, Obsidian)
export OZONE_PLATFORM="wayland" # Chromium and electron apps
export MOZ_ENABLE_WAYLAND="1" # Firefox / Thunderbird
export GDK_BACKEND="wayland,x11,*" # GTK 3 & GTK 4 apps (falls back to X11 if Wayland fails)
export QT_QPA_PLATFORM="wayland;xcb" # Qt 5 & Qt 6 apps (falls back to XCB/X11 if needed)
export SDL_VIDEODRIVER="wayland,x11" # Games & SDL2/SDL3 applications
export CLUTTER_BACKEND="wayland" # Older Clutter-based applications
export WLR_NO_HARDWARE_CURSORS="1" # General Wayland graphics fix

# ------------------------------------------------------------------------------

# -- QT VARIABLES
#    https://wiki.hypr.land/Configuring/Advanced-and-Cool/Environment-variables/#qt-variables

# Enable automatic scaling, based on the monitor’s pixel density
export QT_AUTO_SCREEN_SCALE_FACTOR="1"

# Disable window decorations on Qt applications
export QT_WAYLAND_DISABLE_WINDOWDECORATION="1"

